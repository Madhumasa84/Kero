{
  "$defs": {
    "AnalysisMode": {
      "enum": [
        "MOCK",
        "EXPERIMENTAL"
      ],
      "title": "AnalysisMode",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "data_base64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Base64"
        },
        "media_type": {
          "default": "image/png",
          "title": "Media Type",
          "type": "string"
        },
        "retained": {
          "default": false,
          "title": "Retained",
          "type": "boolean"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "uri": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "artifact_type"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "CalibrationStatus": {
      "enum": [
        "MISSING",
        "INVALID",
        "UNVALIDATED",
        "VALIDATED"
      ],
      "title": "CalibrationStatus",
      "type": "string"
    },
    "CentreDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "candidate_x_px": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate X Px"
        },
        "candidate_y_px": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Y Px"
        },
        "edge_point_count": {
          "minimum": 0,
          "title": "Edge Point Count",
          "type": "integer"
        },
        "peak_vote_count": {
          "minimum": 0,
          "title": "Peak Vote Count",
          "type": "number"
        },
        "ring_angular_coverage": {
          "items": {
            "type": "number"
          },
          "title": "Ring Angular Coverage",
          "type": "array"
        },
        "search_region_xyxy_px": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Search Region Xyxy Px",
          "type": "array"
        },
        "supporting_bright_ring_radii_px": {
          "items": {
            "type": "number"
          },
          "title": "Supporting Bright Ring Radii Px",
          "type": "array"
        },
        "supporting_edge_band_count": {
          "minimum": 0,
          "title": "Supporting Edge Band Count",
          "type": "integer"
        },
        "supporting_edge_radii_px": {
          "items": {
            "type": "number"
          },
          "title": "Supporting Edge Radii Px",
          "type": "array"
        }
      },
      "required": [
        "edge_point_count",
        "peak_vote_count",
        "supporting_edge_band_count",
        "search_region_xyxy_px"
      ],
      "title": "CentreDiagnostics",
      "type": "object"
    },
    "CentreInformation": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "default": "image_pixels_xy",
          "title": "Coordinate System",
          "type": "string"
        },
        "diagnostics": {
          "anyOf": [
            {
              "$ref": "#/$defs/CentreDiagnostics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "experimental": {
          "default": false,
          "title": "Experimental",
          "type": "boolean"
        },
        "failure_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "status": {
          "$ref": "#/$defs/CentreStatus",
          "default": "NOT_DETECTED"
        },
        "x_px": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Px"
        },
        "y_px": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y Px"
        }
      },
      "title": "CentreInformation",
      "type": "object"
    },
    "CentreStatus": {
      "enum": [
        "NOT_DETECTED",
        "DETECTED"
      ],
      "title": "CentreStatus",
      "type": "string"
    },
    "Eye": {
      "enum": [
        "OD",
        "OS"
      ],
      "title": "Eye",
      "type": "string"
    },
    "FeatureMeasurements": {
      "additionalProperties": false,
      "properties": {
        "angular_coverage_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angular Coverage Fraction"
        },
        "astigmatism_diopters": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Astigmatism Diopters"
        },
        "experimental": {
          "default": false,
          "title": "Experimental",
          "type": "boolean"
        },
        "mean_k_diopters": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean K Diopters"
        },
        "mean_radial_asymmetry_px": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Radial Asymmetry Px"
        },
        "mean_ring_spacing_px": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Ring Spacing Px"
        },
        "measurement_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Unit"
        },
        "missing_sector_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Sector Count"
        },
        "ring_spacing_stddev_px": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ring Spacing Stddev Px"
        },
        "sim_k1_diopters": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sim K1 Diopters"
        },
        "sim_k2_diopters": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sim K2 Diopters"
        },
        "status": {
          "$ref": "#/$defs/FeatureStatus",
          "default": "NOT_RUN"
        },
        "validity": {
          "$ref": "#/$defs/MeasurementValidity",
          "default": "UNAVAILABLE"
        }
      },
      "title": "FeatureMeasurements",
      "type": "object"
    },
    "FeatureStatus": {
      "enum": [
        "NOT_RUN",
        "EXTRACTED"
      ],
      "title": "FeatureStatus",
      "type": "string"
    },
    "ImageFormat": {
      "enum": [
        "JPEG",
        "PNG"
      ],
      "title": "ImageFormat",
      "type": "string"
    },
    "MeasurementValidity": {
      "enum": [
        "MEASURED",
        "UNAVAILABLE"
      ],
      "title": "MeasurementValidity",
      "type": "string"
    },
    "Point2D": {
      "additionalProperties": false,
      "properties": {
        "x_px": {
          "title": "X Px",
          "type": "number"
        },
        "y_px": {
          "title": "Y Px",
          "type": "number"
        }
      },
      "required": [
        "x_px",
        "y_px"
      ],
      "title": "Point2D",
      "type": "object"
    },
    "QualityMeasurements": {
      "additionalProperties": false,
      "properties": {
        "blur_laplacian_variance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blur Laplacian Variance"
        },
        "brightness_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brightness Mean"
        },
        "channel_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Count"
        },
        "contrast_stddev": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contrast Stddev"
        },
        "experimental": {
          "default": false,
          "title": "Experimental",
          "type": "boolean"
        },
        "image_height_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Height Px"
        },
        "image_width_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Width Px"
        },
        "missing_sector_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Sector Count"
        },
        "orientation_transformation": {
          "default": "none",
          "title": "Orientation Transformation",
          "type": "string"
        },
        "saturated_pixel_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saturated Pixel Fraction"
        },
        "sector_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector Count"
        },
        "source_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/QualityStatus",
          "default": "NOT_ASSESSED"
        },
        "underexposed_pixel_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Underexposed Pixel Fraction"
        },
        "validity": {
          "$ref": "#/$defs/MeasurementValidity",
          "default": "UNAVAILABLE"
        },
        "visible_ring_coverage_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible Ring Coverage Fraction"
        }
      },
      "title": "QualityMeasurements",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "NOT_ASSESSED",
        "MEASURED",
        "INVALID"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "MOCK_MODE",
        "ANALYSIS_NOT_PERFORMED",
        "CALIBRATION_UNVALIDATED",
        "CALIBRATION_MISSING",
        "CALIBRATION_INVALID",
        "DEVICE_UNKNOWN",
        "DEVICE_CONFIGURATION_MISMATCH",
        "IMAGE_EMPTY",
        "IMAGE_CORRUPT",
        "IMAGE_UNSUPPORTED_FORMAT",
        "IMAGE_EXTENSION_CONTENT_MISMATCH",
        "IMAGE_TOO_LARGE",
        "IMAGE_DIMENSIONS_EXCEEDED",
        "IMAGE_READ_ERROR",
        "INVALID_METADATA",
        "CLINICAL_OUTPUT_BLOCKED",
        "STAGE_NOT_IMPLEMENTED",
        "CENTRE_NOT_FOUND",
        "CENTRE_UNRELIABLE",
        "RING_CANDIDATES_NOT_FOUND",
        "RING_TRACKING_INSUFFICIENT",
        "POLAR_SAMPLING_FAILED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ResultStatus": {
      "enum": [
        "RECAPTURE_REQUIRED",
        "MANUAL_REVIEW",
        "PENTACAM_EVALUATION_RECOMMENDED",
        "SCREEN_NEGATIVE",
        "BLOCKED"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "RingTrack": {
      "additionalProperties": false,
      "properties": {
        "coverage_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage Fraction",
          "type": "number"
        },
        "mean_radius_px": {
          "minimum": 0,
          "title": "Mean Radius Px",
          "type": "number"
        },
        "ordered_index": {
          "minimum": 1,
          "title": "Ordered Index",
          "type": "integer"
        },
        "radii_px": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 1,
          "title": "Radii Px",
          "type": "array"
        },
        "radius_asymmetry_px": {
          "minimum": 0,
          "title": "Radius Asymmetry Px",
          "type": "number"
        },
        "radius_range_px": {
          "minimum": 0,
          "title": "Radius Range Px",
          "type": "number"
        },
        "validity_mask": {
          "items": {
            "type": "boolean"
          },
          "minItems": 1,
          "title": "Validity Mask",
          "type": "array"
        }
      },
      "required": [
        "ordered_index",
        "mean_radius_px",
        "radius_range_px",
        "radius_asymmetry_px",
        "coverage_fraction",
        "radii_px",
        "validity_mask"
      ],
      "title": "RingTrack",
      "type": "object"
    },
    "RingTrackingInformation": {
      "additionalProperties": false,
      "properties": {
        "angle_samples_deg": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle Samples Deg"
        },
        "angular_coverage_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angular Coverage Fraction"
        },
        "candidate_radii_by_angle_px": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Radii By Angle Px"
        },
        "experimental": {
          "default": false,
          "title": "Experimental",
          "type": "boolean"
        },
        "failure_reasons": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Failure Reasons",
          "type": "array"
        },
        "missing_sector_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Sector Count"
        },
        "ring_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ring Count"
        },
        "rings": {
          "items": {
            "$ref": "#/$defs/RingTrack"
          },
          "title": "Rings",
          "type": "array"
        },
        "sector_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector Count"
        },
        "status": {
          "$ref": "#/$defs/RingTrackingStatus",
          "default": "NOT_RUN"
        },
        "tracked_points": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Point2D"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracked Points"
        },
        "tracked_ring_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracked Ring Count"
        },
        "validity": {
          "$ref": "#/$defs/MeasurementValidity",
          "default": "UNAVAILABLE"
        }
      },
      "title": "RingTrackingInformation",
      "type": "object"
    },
    "RingTrackingStatus": {
      "enum": [
        "NOT_RUN",
        "TRACKED",
        "FAILED"
      ],
      "title": "RingTrackingStatus",
      "type": "string"
    },
    "StageExecution": {
      "additionalProperties": false,
      "properties": {
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 3339 date-time with an explicit timezone offset.",
          "pattern": ".*(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Finished At"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "stage_name": {
          "$ref": "#/$defs/StageName"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 3339 date-time with an explicit timezone offset.",
          "pattern": ".*(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Started At"
        },
        "state": {
          "$ref": "#/$defs/StageState"
        }
      },
      "required": [
        "stage_name",
        "state",
        "message"
      ],
      "title": "StageExecution",
      "type": "object"
    },
    "StageName": {
      "enum": [
        "INPUT_VALIDATION",
        "DEVICE_CONFIGURATION_VALIDATION",
        "IMAGE_LOADING",
        "CALIBRATION_VALIDATION",
        "QUALITY_ASSESSMENT",
        "CENTRE_DETECTION",
        "SEGMENTATION",
        "POLAR_SAMPLING",
        "RING_TRACKING",
        "FEATURE_EXTRACTION",
        "OUTCOME_POLICY"
      ],
      "title": "StageName",
      "type": "string"
    },
    "StageState": {
      "enum": [
        "NOT_RUN",
        "PASSED",
        "FAILED",
        "BLOCKED"
      ],
      "title": "StageState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "format": "uuid",
      "title": "Analysis Id",
      "type": "string"
    },
    "analysis_mode": {
      "$ref": "#/$defs/AnalysisMode"
    },
    "anonymous_patient_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Anonymous Patient Id",
      "type": "string"
    },
    "artifact_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Artifact References",
      "type": "array"
    },
    "calibration_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration Identifier"
    },
    "calibration_status": {
      "$ref": "#/$defs/CalibrationStatus"
    },
    "capture_session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Capture Session Id",
      "type": "string"
    },
    "capture_timestamp": {
      "description": "RFC 3339 date-time with an explicit timezone offset.",
      "format": "date-time",
      "pattern": ".*(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Capture Timestamp",
      "type": "string"
    },
    "centre_information": {
      "$ref": "#/$defs/CentreInformation"
    },
    "device_configuration_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Configuration Hash"
    },
    "device_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Device Version",
      "type": "string"
    },
    "eye": {
      "$ref": "#/$defs/Eye"
    },
    "features": {
