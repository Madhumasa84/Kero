{
  "$defs": {
    "AnalysisMode": {
      "enum": [
        "MOCK"
      ],
      "title": "AnalysisMode",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "retained": {
          "default": false,
          "title": "Retained",
          "type": "boolean"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "uri": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "uri"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "CalibrationStatus": {
      "enum": [
        "MISSING",
        "INVALID",
        "UNVALIDATED",
        "VALIDATED"
      ],
      "title": "CalibrationStatus",
      "type": "string"
    },
    "CentreInformation": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "default": "image_pixels_xy",
          "title": "Coordinate System",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "status": {
          "$ref": "#/$defs/CentreStatus",
          "default": "NOT_DETECTED"
        },
        "x_px": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Px"
        },
        "y_px": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y Px"
        }
      },
      "title": "CentreInformation",
      "type": "object"
    },
    "CentreStatus": {
      "enum": [
        "NOT_DETECTED",
        "DETECTED"
      ],
      "title": "CentreStatus",
      "type": "string"
    },
    "Eye": {
      "enum": [
        "OD",
        "OS"
      ],
      "title": "Eye",
      "type": "string"
    },
    "FeatureMeasurements": {
      "additionalProperties": false,
      "properties": {
        "astigmatism_diopters": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Astigmatism Diopters"
        },
        "mean_k_diopters": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean K Diopters"
        },
        "sim_k1_diopters": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sim K1 Diopters"
        },
        "sim_k2_diopters": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sim K2 Diopters"
        },
        "status": {
          "$ref": "#/$defs/FeatureStatus",
          "default": "NOT_RUN"
        },
        "validity": {
          "$ref": "#/$defs/MeasurementValidity",
          "default": "UNAVAILABLE"
        }
      },
      "title": "FeatureMeasurements",
      "type": "object"
    },
    "FeatureStatus": {
      "enum": [
        "NOT_RUN",
        "EXTRACTED"
      ],
      "title": "FeatureStatus",
      "type": "string"
    },
    "ImageFormat": {
      "enum": [
        "JPEG",
        "PNG"
      ],
      "title": "ImageFormat",
      "type": "string"
    },
    "MeasurementValidity": {
      "enum": [
        "MEASURED",
        "UNAVAILABLE"
      ],
      "title": "MeasurementValidity",
      "type": "string"
    },
    "Point2D": {
      "additionalProperties": false,
      "properties": {
        "x_px": {
          "title": "X Px",
          "type": "number"
        },
        "y_px": {
          "title": "Y Px",
          "type": "number"
        }
      },
      "required": [
        "x_px",
        "y_px"
      ],
      "title": "Point2D",
      "type": "object"
    },
    "QualityMeasurements": {
      "additionalProperties": false,
      "properties": {
        "brightness_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brightness Mean"
        },
        "channel_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Count"
        },
        "contrast_stddev": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contrast Stddev"
        },
        "image_height_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Height Px"
        },
        "image_width_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Width Px"
        },
        "orientation_transformation": {
          "default": "none",
          "title": "Orientation Transformation",
          "type": "string"
        },
        "source_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/QualityStatus",
          "default": "NOT_ASSESSED"
        },
        "validity": {
          "$ref": "#/$defs/MeasurementValidity",
          "default": "UNAVAILABLE"
        }
      },
      "title": "QualityMeasurements",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "NOT_ASSESSED",
        "MEASURED",
        "INVALID"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "MOCK_MODE",
        "ANALYSIS_NOT_PERFORMED",
        "CALIBRATION_UNVALIDATED",
        "CALIBRATION_MISSING",
        "CALIBRATION_INVALID",
        "DEVICE_UNKNOWN",
        "DEVICE_CONFIGURATION_MISMATCH",
        "IMAGE_EMPTY",
        "IMAGE_CORRUPT",
        "IMAGE_UNSUPPORTED_FORMAT",
        "IMAGE_EXTENSION_CONTENT_MISMATCH",
        "IMAGE_TOO_LARGE",
        "IMAGE_DIMENSIONS_EXCEEDED",
        "IMAGE_READ_ERROR",
        "INVALID_METADATA",
        "CLINICAL_OUTPUT_BLOCKED",
        "STAGE_NOT_IMPLEMENTED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ResultStatus": {
      "enum": [
        "RECAPTURE_REQUIRED",
        "MANUAL_REVIEW",
        "PENTACAM_EVALUATION_RECOMMENDED",
        "SCREEN_NEGATIVE",
        "BLOCKED"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "RingTrackingInformation": {
      "additionalProperties": false,
      "properties": {
        "ring_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ring Count"
        },
        "status": {
          "$ref": "#/$defs/RingTrackingStatus",
          "default": "NOT_RUN"
        },
        "tracked_points": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Point2D"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracked Points"
        },
        "tracked_ring_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracked Ring Count"
        },
        "validity": {
          "$ref": "#/$defs/MeasurementValidity",
          "default": "UNAVAILABLE"
        }
      },
      "title": "RingTrackingInformation",
      "type": "object"
    },
    "RingTrackingStatus": {
      "enum": [
        "NOT_RUN",
        "TRACKED"
      ],
      "title": "RingTrackingStatus",
      "type": "string"
    },
    "StageExecution": {
      "additionalProperties": false,
      "properties": {
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 3339 date-time with an explicit timezone offset.",
          "pattern": ".*(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Finished At"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "stage_name": {
          "$ref": "#/$defs/StageName"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 3339 date-time with an explicit timezone offset.",
          "pattern": ".*(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Started At"
        },
        "state": {
          "$ref": "#/$defs/StageState"
        }
      },
      "required": [
        "stage_name",
        "state",
        "message"
      ],
      "title": "StageExecution",
      "type": "object"
    },
    "StageName": {
      "enum": [
        "INPUT_VALIDATION",
        "DEVICE_CONFIGURATION_VALIDATION",
        "IMAGE_LOADING",
        "CALIBRATION_VALIDATION",
        "QUALITY_ASSESSMENT",
        "CENTRE_DETECTION",
        "SEGMENTATION",
        "RING_TRACKING",
        "FEATURE_EXTRACTION",
        "OUTCOME_POLICY"
      ],
      "title": "StageName",
      "type": "string"
    },
    "StageState": {
      "enum": [
        "NOT_RUN",
        "PASSED",
        "FAILED",
        "BLOCKED"
      ],
      "title": "StageState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "format": "uuid",
      "title": "Analysis Id",
      "type": "string"
    },
    "analysis_mode": {
      "$ref": "#/$defs/AnalysisMode"
    },
    "anonymous_patient_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Anonymous Patient Id",
      "type": "string"
    },
    "artifact_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Artifact References",
      "type": "array"
    },
    "calibration_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration Identifier"
    },
    "calibration_status": {
      "$ref": "#/$defs/CalibrationStatus"
    },
    "capture_session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Capture Session Id",
      "type": "string"
    },
    "capture_timestamp": {
      "description": "RFC 3339 date-time with an explicit timezone offset.",
      "format": "date-time",
      "pattern": ".*(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Capture Timestamp",
      "type": "string"
    },
    "centre_information": {
      "$ref": "#/$defs/CentreInformation"
    },
    "device_configuration_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Configuration Hash"
    },
    "device_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Device Version",
      "type": "string"
    },
    "eye": {
      "$ref": "#/$defs/Eye"
    },
    "features": {
      "$ref": "#/$defs/FeatureMeasurements"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "operator_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Operator Id",
      "type": "string"
    },
    "original_image_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Image Sha256"
    },
    "quality_measurements": {
      "$ref": "#/$defs/QualityMeasurements"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "ring_tracking": {
      "$ref": "#/$defs/RingTrackingInformation"
    },
    "schema_version": {
      "default": "1.0.0",
      "maxLength": 32,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "screening_disclaimer": {
      "default": "Screening/referral support only; not a diagnosis. Pentacam and clinician review are required for confirmation.",
      "title": "Screening Disclaimer",
      "type": "string"
    },
    "software_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Software Version",
      "type": "string"
    },
    "stage_execution": {
      "items": {
        "$ref": "#/$defs/StageExecution"
      },
      "minItems": 1,
      "title": "Stage Execution",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ResultStatus"
    },
    "timestamp": {
      "description": "RFC 3339 date-time with an explicit timezone offset.",
      "format": "date-time",
      "pattern": ".*(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "software_version",
    "analysis_id",
    "analysis_mode",
    "timestamp",
    "anonymous_patient_id",
    "eye",
    "capture_session_id",
    "operator_id",
    "capture_timestamp",
    "status",
    "reason_codes",
    "message",
    "stage_execution",
    "device_version",
    "calibration_status",
    "quality_measurements",
    "centre_information",
    "ring_tracking",
    "features"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
