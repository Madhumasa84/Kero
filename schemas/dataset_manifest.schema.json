{
  "$defs": {
    "DatasetManifestRow": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Id"
        },
        "anonymous_patient_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Anonymous Patient Id",
          "type": "string"
        },
        "capture_session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capture Session Id",
          "type": "string"
        },
        "capture_timestamp": {
          "description": "RFC 3339 date-time with an explicit timezone offset.",
          "format": "date-time",
          "pattern": ".*(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Capture Timestamp",
          "type": "string"
        },
        "device_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Device Version",
          "type": "string"
        },
        "eye": {
          "$ref": "#/$defs/Eye"
        },
        "image_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Image Path",
          "type": "string"
        },
        "operator_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operator Id",
          "type": "string"
        },
        "original_image_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Image Sha256"
        },
        "row_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Row Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "maxLength": 32,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "row_id",
        "anonymous_patient_id",
        "eye",
        "capture_session_id",
        "device_version",
        "operator_id",
        "capture_timestamp",
        "image_path"
      ],
      "title": "DatasetManifestRow",
      "type": "object"
    },
    "Eye": {
      "enum": [
        "OD",
        "OS"
      ],
      "title": "Eye",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "description": "RFC 3339 date-time with an explicit timezone offset.",
      "format": "date-time",
      "pattern": ".*(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Created At",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/DatasetManifestRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "maxLength": 32,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "created_at"
  ],
  "title": "DatasetManifest",
  "type": "object"
}
