{
  "$defs": {
    "AnalysisMode": {
      "enum": [
        "MOCK"
      ],
      "title": "AnalysisMode",
      "type": "string"
    },
    "Eye": {
      "enum": [
        "OD",
        "OS"
      ],
      "title": "Eye",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Metadata submitted with one original capture image.",
  "properties": {
    "analysis_mode": {
      "$ref": "#/$defs/AnalysisMode",
      "default": "MOCK"
    },
    "anonymous_patient_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Anonymous Patient Id",
      "type": "string"
    },
    "capture_session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Capture Session Id",
      "type": "string"
    },
    "capture_timestamp": {
      "description": "RFC 3339 date-time with an explicit timezone offset.",
      "format": "date-time",
      "pattern": ".*(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Capture Timestamp",
      "type": "string"
    },
    "device_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Device Version",
      "type": "string"
    },
    "eye": {
      "$ref": "#/$defs/Eye"
    },
    "operator_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Operator Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "maxLength": 32,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "anonymous_patient_id",
    "eye",
    "capture_session_id",
    "device_version",
    "operator_id",
    "capture_timestamp"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
